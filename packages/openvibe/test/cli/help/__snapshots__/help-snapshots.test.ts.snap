// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`openvibe CLI help-text snapshots every documented command emits stable help text: openvibe acp --help 1`] = `
"openvibe acp

start ACP (Agent Client Protocol) server

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         port to listen on                                         [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: openvibe.local)
                                                                [string] [default: "openvibe.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
      --cwd          working directory [string] [default: "<HOME>"]"
`;

exports[`openvibe CLI help-text snapshots every documented command emits stable help text: openvibe mcp --help 1`] = `
"openvibe mcp

manage MCP (Model Context Protocol) servers

Commands:
  openvibe mcp add [name]     add an MCP server
  openvibe mcp list           list MCP servers and their status                        [aliases: ls]
  openvibe mcp auth [name]    authenticate with an OAuth-enabled MCP server
  openvibe mcp logout [name]  remove OAuth credentials for an MCP server
  openvibe mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`openvibe CLI help-text snapshots every documented command emits stable help text: openvibe attach --help 1`] = `
"openvibe attach <url>

attach to a running openvibe server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      continue the last session                                            [boolean]
  -s, --session       session id to continue                                                [string]
      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to OPENVIBE_SERVER_PASSWORD)            [string]
  -u, --username      basic auth username (defaults to OPENVIBE_SERVER_USERNAME or 'openvibe')
                                                                                            [string]
      --mini          start the minimal interactive interface             [boolean] [default: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [number]"
`;

exports[`openvibe CLI help-text snapshots every documented command emits stable help text: openvibe run --help 1`] = `
"openvibe run [message..]

run openvibe with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      the command to run, use message for args                               [string]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                                 [string]
      --fork         fork the session before continuing (requires --continue or --session) [boolean]
  -m, --model        model to use in the format of provider/model                           [string]
      --agent        agent to use                                                           [string]
      --format       format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file         file(s) to attach to message                                            [array]
      --title        title for the session (uses truncated prompt if no value provided)     [string]
      --attach       attach to a running openvibe server (e.g., http://localhost:4096)      [string]
  -p, --password     basic auth password (defaults to OPENVIBE_SERVER_PASSWORD)             [string]
  -u, --username     basic auth username (defaults to OPENVIBE_SERVER_USERNAME or 'openvibe')
                                                                                            [string]
      --dir          directory to run in, path on remote server if attaching                [string]
      --port         port for the local server (defaults to random port if no value provided)
                                                                                            [number]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [string]
      --thinking     show thinking blocks                                                  [boolean]
  -i, --interactive  run in direct interactive split-footer mode          [boolean] [default: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]"
`;

exports[`openvibe CLI help-text snapshots every documented command emits stable help text: openvibe debug --help 1`] = `
"openvibe debug

debugging and troubleshooting tools

Commands:
  openvibe debug config        show resolved configuration
  openvibe debug lsp           LSP debugging utilities
  openvibe debug rg            ripgrep debugging utilities
  openvibe debug file          file system debugging utilities
  openvibe debug scrap         list all known projects
  openvibe debug skill         list all available skills
  openvibe debug snapshot      snapshot debugging utilities
  openvibe debug startup       print startup timing
  openvibe debug agent <name>  show agent configuration details
  openvibe debug v2            debug v2 catalog and built-in plugins
  openvibe debug info          show debug information
  openvibe debug paths         show global paths (data, config, cache, state)
  openvibe debug wait          wait indefinitely (for debugging)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
